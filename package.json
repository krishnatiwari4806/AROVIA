{
  "name": "arovia",
  "version": "1.0.0",
  "private": true,
  "description": "AROVIA — AI-Powered Interview Evaluation Platform",
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"cyan.bold,magenta.bold\" --kill-others \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "test:backend": "pytest backend",
    "test": "pytest backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
